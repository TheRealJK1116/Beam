# Copy to keystore.properties (gitignored) and fill in to produce an installable release.
#
# Create the keystore yourself and keep it safe — it is the identity of the app. Losing it
# means no future build can ever update an installed copy:
#
#   keytool -genkeypair -v -keystore beam-release.jks -alias beam \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to the repository root.

storeFile=beam-release.jks
storePassword=
keyAlias=beam
keyPassword=
