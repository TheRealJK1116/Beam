<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Beam never contacts a server: everything happens over NFC and a direct radio link between
      the two phones, with no account, no cloud and no analytics.

      INTERNET is nonetheless required, and the name is misleading. Android gates the socket()
      syscall itself behind this permission, so creating a TCP socket needs it even when the
      only address it will ever talk to is 192.168.49.1 on a Wi-Fi Direct group with no route
      off the device. Without it the Wi-Fi Direct transport dies with EPERM.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.NFC" />

    <!--
      Nearby Connections' radio permissions.

      BLUETOOTH_SCAN carries usesPermissionFlags="neverForLocation". Without the flag, Nearby
      refuses to scan unless the app holds ACCESS_COARSE_LOCATION (status 8034) - a permission
      Beam has no business requesting to move a file between two phones that are touching.

      On Android 13 and up that means no location permission at all. Android 12 has no
      equivalent and still routes Wi-Fi scanning through location, so there the two permissions
      below are requested; this comment used to claim otherwise.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Legacy equivalents, for the Nearby code paths that still check them. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      Android 12 only: Nearby's Wi-Fi scanning is gated behind location there. Both are
      declared because the platform will not grant fine without coarse, and both disappear
      from the install on Android 13 and up.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Android 13+ replaces that with a purpose-specific permission. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Android 16's local-network protections. Nearby Connections moves the payload over a
      direct link between the two phones, which counts as local network access, and refuses to
      advertise or discover without this. It is a runtime (dangerous) permission.

      Worth knowing if you ever see this fail: Play Services has no status code mapped to it,
      so a missing grant surfaces as a bare INTERNAL_ERROR (status 8) with the real reason only
      in GMS's own logcat output.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      A multi-gigabyte beam outlasts the screen timeout. Without a partial wake lock the CPU
      sleeps and the Wi-Fi chip powers down mid-stream, which the other phone sees as the
      connection dying.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Puts the accept screen in front of someone whose phone was locked and in their hand.

      A tap is as deliberate as answering a call and just as short-lived, which is the case
      this is for. From Android 14 it is a special app access rather than an ordinary
      permission, and it is granted by default only to calling and alarm apps, so Beam asks
      for it and carries on without it: the fallback is an ordinary high-priority notification
      the user taps. Without the declaration there is no toggle for them to find at all.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Lets Beam ask to be exempted from battery optimisation.

      This is core functionality rather than a convenience: receiving works by the platform
      binding BeamHceService when another phone taps this one, and a doze-restricted or
      OEM-killed app is not there to be bound. Several manufacturers - Nothing OS among them -
      are considerably more aggressive than stock Android about this.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".BeamApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beam">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share-sheet entry point: this is how a beam starts. -->
        <activity
            android:name=".ui.SendActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_target_label"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Beam">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Launched over the lock screen by the transfer service's full-screen intent, so a beam
          can be accepted without unlocking and opening the app first.
        -->
        <activity
            android:name=".ui.ReceiveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Beam" />

        <service
            android:name=".BeamTransferService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
