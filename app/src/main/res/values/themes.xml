<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this only has to exist before the first frame. -->
    <style name="Theme.Beam" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The send and receive screens sit over whatever is behind them. -->
    <style name="Theme.Beam.Transparent" parent="Theme.Beam">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
